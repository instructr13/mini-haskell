name:           mini-haskell
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/instructr13/mini-haskell#readme>
homepage:       https://github.com/instructr13/mini-haskell#readme
bug-reports:    https://github.com/instructr13/mini-haskell/issues
author:         Mido <mido@wycey.dev>
maintainer:     Mido <mido@wycey.dev>
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md

source-repository head
  type: git
  location: https://github.com/instructr13/mini-haskell

library
  exposed-modules:
      List
      Test
      TRS
      TRSParser
  other-modules:
      Paths_mini_haskell
  hs-source-dirs:
      src
